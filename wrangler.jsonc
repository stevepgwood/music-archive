{
  "name": "music-archive",
  "main": "src/index.js",
  "compatibility_date": "2025-11-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/download/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "archive" }],
  // Leave empty to serve audio/artwork through the Worker.
  // Set to your public R2 address (e.g. "https://media.yourdomain.com") to serve them straight from R2.
  "vars": { "MEDIA_BASE": "" }
}
